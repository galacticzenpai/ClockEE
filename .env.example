# ==============================================================================
# ClockEE Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` or `.env.local` for local environment configurations.
# NEVER commit `.env` or sensitive credentials to version control.
# ==============================================================================

# TickTick Tasks Integration API Client Token
TICKTICK_API_TOKEN=your_ticktick_client_token_here

# Google Gemini API Key (for Adaptive Problem Generation & AI Tutor)
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Realtime Database & Authentication Configuration
FIREBASE_API_KEY=your_firebase_web_api_key_here
FIREBASE_AUTH_DOMAIN=your-clockee-app.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-clockee-app-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=your-clockee-app
FIREBASE_STORAGE_BUCKET=your-clockee-app.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef
FIREBASE_MEASUREMENT_ID=G-ABCDEF1234

# Master Supervisor Admin PIN (Default fallback in development: 2028)
ADMIN_PIN=your_secure_admin_pin_here
