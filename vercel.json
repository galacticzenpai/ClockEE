{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/timer", "destination": "/timer" },
    { "source": "/today", "destination": "/today" },
    { "source": "/tasks", "destination": "/task" },
    { "source": "/task", "destination": "/task" },
    { "source": "/coaching", "destination": "/coaching" },
    { "source": "/cbt/exam", "destination": "/cbt_exam" },
    { "source": "/cbt", "destination": "/cbt_home" },
    { "source": "/mistakes", "destination": "/cbt_mistakes" },
    { "source": "/notebooks", "destination": "/cbt_notebooks" },
    { "source": "/syllabus", "destination": "/tracker" },
    { "source": "/tracker", "destination": "/live_tracker" },
    { "source": "/mesh", "destination": "/live_tracker" },
    { "source": "/cockpit", "destination": "/live_tracker" },
    { "source": "/api/tracker", "destination": "/mesh/mesh_tracker_state.json" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
