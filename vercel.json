{
  "version": 2,
  "name": "clockee-os-2",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/timer", "destination": "/timer.html" },
    { "source": "/today", "destination": "/today.html" },
    { "source": "/tasks", "destination": "/task.html" },
    { "source": "/task", "destination": "/task.html" },
    { "source": "/coaching", "destination": "/coaching.html" },
    { "source": "/cbt/exam", "destination": "/cbt_exam.html" },
    { "source": "/cbt", "destination": "/cbt_home.html" },
    { "source": "/mistakes", "destination": "/cbt_mistakes.html" },
    { "source": "/notebooks", "destination": "/cbt_notebooks.html" },
    { "source": "/syllabus", "destination": "/tracker.html" },
    { "source": "/tracker", "destination": "/live_tracker.html" },
    { "source": "/mesh", "destination": "/live_tracker.html" },
    { "source": "/cockpit", "destination": "/live_tracker.html" },
    { "source": "/api/tracker", "destination": "/mesh/mesh_tracker_state.json" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
