{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "ClockEE Apple Human Interface Design System Tokens",
  "version": "2.0.0",
  "color": {
    "system_materials": {
      "base": { "value": "#000000", "type": "color" },
      "surface": { "value": "#1c1c1e", "type": "color" },
      "elevated": { "value": "#2c2c2e", "type": "color" },
      "card": { "value": "rgba(28, 28, 30, 0.72)", "type": "color" },
      "border": { "value": "rgba(255, 255, 255, 0.08)", "type": "color" },
      "border_medium": { "value": "rgba(255, 255, 255, 0.16)", "type": "color" },
      "border_focus": { "value": "rgba(10, 132, 255, 0.65)", "type": "color" }
    },
    "apple_accents": {
      "system_blue": { "value": "#0a84ff", "type": "color" },
      "system_blue_dark": { "value": "#0066cc", "type": "color" },
      "system_blue_light": { "value": "rgba(10, 132, 255, 0.12)", "type": "color" },
      "system_green": { "value": "#30d158", "type": "color" },
      "system_orange": { "value": "#ff9f0a", "type": "color" },
      "system_red": { "value": "#ff453a", "type": "color" },
      "system_purple": { "value": "#bf5af2", "type": "color" }
    },
    "text": {
      "primary": { "value": "#ffffff", "type": "color" },
      "secondary": { "value": "rgba(235, 235, 245, 0.64)", "type": "color" },
      "muted": { "value": "rgba(235, 235, 245, 0.38)", "type": "color" }
    },
    "typography": {
      "font_sans": { "value": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'SF Pro Display', 'SF Pro', 'Helvetica Neue', Helvetica, Arial, sans-serif", "type": "fontFamily" },
      "font_mono": { "value": "'SF Mono', 'JetBrains Mono', Menlo, Monaco, Consolas, monospace", "type": "fontFamily" }
    },
    "effects": {
      "glass_blur": { "value": "blur(25px) saturate(190%)", "type": "filter" },
      "ease_apple": { "value": "cubic-bezier(0.16, 1, 0.3, 1)", "type": "transitionTimingFunction" }
    }
  }
}
